# Recipe: the preference stage that produced `prefcc` (fact-rewarded DPO), written out in full.
# Source a student profile first (configs/students/<tag>.env), then this file.
# Run names: ${STUDENT_TAG}-prefcc (pair order as built) and ${STUDENT_TAG}-prefcc-s2 (SCISUM_PREF_ORDER_SEED=1).
#
# Values are Student C's prefcc settings, with every value it inherited from the code defaults written out here,
# so no default can drift.
# None of them was tuned (docs/WHAT_WORKED_ON_C.md, "Limits").

# ---- starting point: the student's own final SFT adapter (also the DPO reference) -------------------------
export SCISUM_INIT_ADAPTER=runs/${STUDENT_TAG}-sft50k/ckpt/ex50000/adapter

# ---- 2a. candidates ------------------------------------------------------------------------------------
# One improve directory per student. The questions and reference-reader verdicts are shared (copied in from
# data/improve_pool on first use); the pool's prompts and the samples are the student's own.
export SCISUM_IMP_DIR=improve-${STUDENT_TAG}
export SCISUM_IMP_POOL=1520                 # C's finished pool: the first 1,520 papers of the fixed order
                                            # (questions and reference verdicts ship for the first 2,551)
export SCISUM_IMP_K=5                       # student samples per paper; the teacher is a further candidate
export SCISUM_IMP_TEMPERATURE=0.8
export SCISUM_IMP_TOP_P=0.95
export SCISUM_IMP_GREEDY=false              # C's run: greedy output only for its first 120 papers; off here

# ---- 2b. reward --------------------------------------------------------------------------------------------
export SCISUM_IMP_N_QUESTIONS=14
export SCISUM_IMP_MIN_QUESTIONS=5           # fewer kept questions: the paper gives no pair
export SCISUM_IMP_WRITER=qwen38-27b         # writes the training questions (shipped; only new papers need it)
export SCISUM_IMP_GRADER=gemma4-31b-it      # answers and grades the candidates
export SCISUM_IMP_LAMBDA=0.15               # + 0.15 x ROUGE-L(candidate, teacher)
export SCISUM_IMP_BETA_NUM=0.30             # - 0.30 x share of numbers not in the paper
export SCISUM_IMP_GAMMA_LEN=1.0             # - 1.0 x max(0, length ratio - 1.0)
export SCISUM_IMP_LEN_FREE=1.0
export SCISUM_IMP_CLAIM_WEIGHT=1.0          # - 1.0 x unsupported-or-contradicted share (claim check)
export SCISUM_IMP_CLAIM_MODEL=gemma4-31b-it
export SCISUM_IMP_MARGIN=0.05               # a sample replaces the teacher's summary only by beating it by 0.05

# ---- 2c. pairs ---------------------------------------------------------------------------------------------
export SCISUM_IMP_PAIR_RULE=closest_length  # rejected = the student sample closest in length to the chosen one
export SCISUM_IMP_PAIR_GAP=0.25             # among those at least 0.25 below it
export SCISUM_IMP_PAIRS_PER_PAPER=1
export SCISUM_IMP_PAIR_FILTER=
export SCISUM_TRAIN_SPLIT=improve-${STUDENT_TAG}-prefcc   # = tokens/<imp_dir>-prefcc, built by `scisum improve build --arm prefcc`

# ---- 2d. DPO -----------------------------------------------------------------------------------------------
export SCISUM_OBJECTIVE=preference
export SCISUM_PREF_BETA=0.1
export SCISUM_PREF_SFT_WEIGHT=1.0           # + 1.0 x NLL of the chosen summary
export SCISUM_PREF_LEN_ALPHA=0.0            # no length term in the loss (R-DPO hurt with length-matched pairs)
export SCISUM_PREF_ORDER_SEED=${SCISUM_PREF_ORDER_SEED:-0}   # the -s2 run sets 1
export SCISUM_LR=2e-5
export SCISUM_WARMUP_FRAC=0.01
export SCISUM_DECAY_FRAC=0.10
export SCISUM_DECAY_FLOOR=0.10
export SCISUM_MAX_GRAD_NORM=1.0
export SCISUM_TOTAL_BATCH=8                 # 8 pairs per optimiser step (one GPU: SCISUM_GRAD_ACCUM=8)
# One pass over the pairs. The number of pairs is known only after `improve build`: the job passes it as
# SUM_IMP_N, and the final adapter is saved as ckpt/ex<pairs>.
export SCISUM_N_TRAIN=${SUM_IMP_N:-1500}
export SCISUM_MILESTONES="[${SUM_IMP_N:-1500}]"
export SCISUM_LOSS_EVAL_EVERY=500
