# Recipe: supervised distillation (SFT) on 50,000 teacher summaries, with Student C's settings.
# Source a student profile first (configs/students/<tag>.env), then this file. Run name: ${STUDENT_TAG}-sft50k.
#
# Student C used exactly these settings on 20,000 papers (docs/WHAT_WORKED_ON_C.md). The only change is
# the number of papers and the milestones. The schedule is warmup-stable-decay, so every milestone before
# the decay (the last 10% of the papers: 45,000-50,000) is an intermediate checkpoint at the peak LR;
# the final, decayed checkpoint is ex50000.
export SCISUM_OBJECTIVE=sft
export SCISUM_TRAIN_SPLIT=train
export SCISUM_N_TRAIN=50000
export SCISUM_MILESTONES='[1000,5000,10000,20000,35000,50000]'
export SCISUM_LOSS_EVAL_EVERY=2500          # held-out loss on 200 validation papers: 20 points on the curve
export SCISUM_LOSS_EVAL_N=200
export SCISUM_SAVE_EVERY_EXAMPLES=2500      # rolling checkpoint: a killed job loses at most 2,500 papers

# LoRA and optimiser (C's)
export SCISUM_LORA_R=64
export SCISUM_LORA_ALPHA=128
export SCISUM_LORA_DROPOUT=0.0
export SCISUM_LR=1e-4
export SCISUM_WARMUP_FRAC=0.01
export SCISUM_DECAY_FRAC=0.10
export SCISUM_DECAY_FLOOR=0.10
export SCISUM_ADAM_BETAS='[0.9,0.95]'
export SCISUM_WEIGHT_DECAY=0.0
export SCISUM_MAX_GRAD_NORM=1.0
export SCISUM_LOSS_IMPL=head_slice
export SCISUM_GRADIENT_CHECKPOINTING=true
# 8 examples per optimiser step in total, one variable-length example per forward pass. The training job
# sets SCISUM_GRAD_ACCUM = 8 / number of GPUs (C: 4 per rank x 2 ranks).
export SCISUM_TOTAL_BATCH=8

# Evaluation at the milestones (greedy decoding, as every number in the earlier work)
export SCISUM_GEN_TEMPERATURE=0.0
export SCISUM_GEN_MAX_NEW_TOKENS=3000
export SCISUM_CURVE_EVAL_N=1000
export SCISUM_FAITHFULNESS_N=300
