# Anchor: Student C (Qwen3.5-9B), with exactly the settings of the earlier work. Not one of the five new
# students. Use it to reproduce C or to benchmark C and prefcc next to the new students: their adapters
# ship in data/anchors/ (C: runs/q35, ckpt ex20000; prefcc: runs/q35prefcc and q35prefccs2, ckpt ex1233).
export STUDENT_TAG=qwen35-9b
export STUDENT_PARAMS=9.4e9
export SCISUM_BASE_MODEL=Qwen/Qwen3.5-9B
export SCISUM_BASE_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
export SCISUM_TRUST_REMOTE_CODE=false
export SCISUM_MAX_SEQ_LEN=32768
export SCISUM_GEN_RESERVE_TOKENS=4096          # prompt budget 28,672 tokens: 91% of papers fit whole
# hybrid: 24 linear-attention layers (in_proj_qkv/out_proj) + 8 full-attention layers (q/k/v/o_proj).
# The recurrence's gate and decay projections (in_proj_a, in_proj_b) stay frozen.
export SCISUM_LORA_TARGETS='["q_proj","k_proj","v_proj","o_proj","in_proj_qkv","out_proj","gate_proj","up_proj","down_proj"]'
# Shipped as a vision-language model (Qwen3_5ForConditionalGeneration). Training loads the text-only class;
# vLLM would load the VL class, whose layer names differ, and silently apply no adapter. Serve a text-only copy:
#   python scripts/make_text_only.py   (writes .cache/text-only/Qwen--Qwen3.5-9B@c202236)
export SCISUM_SERVE_MODEL=.cache/text-only/Qwen--Qwen3.5-9B@c202236
