# Student: Qwen/Qwen3.5-4B. Probed 2026-11-17 (docs/STUDENTS.md): the same hybrid design as Student C
# (Qwen3.5-9B): 24 linear-attention + 8 full-attention layers, ~4.2 B text-model parameters with TIED
# embeddings (248,320 tokens), context 262k. Settings follow C's.
export STUDENT_TAG=qwen35-4b
export STUDENT_PARAMS=4.21e9
export SCISUM_BASE_MODEL=Qwen/Qwen3.5-4B
export SCISUM_BASE_MODEL_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
export SCISUM_TRUST_REMOTE_CODE=false
export SCISUM_MAX_SEQ_LEN=32768
export SCISUM_GEN_RESERVE_TOKENS=4096          # prompt budget 28,672 tokens: 95% of probed bodies fit whole
# C's list: full attention (q/k/v/o), linear attention (in_proj_qkv, out_proj) and the MLP. The recurrence's
# gate/decay projections (in_proj_a, in_proj_b) and the output gate in_proj_z stay frozen, as in C.
export SCISUM_LORA_TARGETS='["q_proj","k_proj","v_proj","o_proj","in_proj_qkv","out_proj","gate_proj","up_proj","down_proj"]'
# Shipped as a vision-language model (Qwen3_5ForConditionalGeneration). Training loads the text-only class;
# vLLM would load the VL class, whose layer names differ, and silently apply no adapter (the Student C
# lesson). Serve a text-only copy: python scripts/make_text_only.py (writes the path below). UNTESTED for
# this model: its embeddings are tied (no lm_head tensor); check with scripts/probe_vllm_adapter.py.
export SCISUM_SERVE_MODEL=.cache/text-only/Qwen--Qwen3.5-4B@851bf6e
